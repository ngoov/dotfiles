#!/bin/bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  exit 0
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is required before applying these dotfiles." >&2
  exit 1
fi

cli_formulae=(
  bat
  caddy
  direnv
  eza
  fd
  fnm
  fzf
  herdr
  htop
  oh-my-posh
  opencode
  pnpm
  ruby
  thefuck
  uv
  zoxide
)

missing=()
for formula in "${cli_formulae[@]}"; do
  if ! brew list --formula --versions "$formula" >/dev/null 2>&1; then
    missing+=("$formula")
  fi
done

if ((${#missing[@]})); then
  brew install "${missing[@]}"
fi

if ! brew list --cask --versions git-credential-manager >/dev/null 2>&1; then
  brew install --cask git-credential-manager
fi

if ! brew list --formula --versions bun >/dev/null 2>&1 && ! command -v bun >/dev/null 2>&1; then
  brew install bun
fi

if ! fnm default >/dev/null 2>&1; then
  fnm install --lts
  fnm default lts-latest
fi

if ! command -v dotnet >/dev/null 2>&1; then
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl --fail --silent --show-error --location https://dot.net/v1/dotnet-install.sh --output "$installer"
  bash "$installer" --channel LTS --install-dir "$HOME/.dotnet"
fi
