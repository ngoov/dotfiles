# Keybindings
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
# CTRL+Space
bindkey '^@' fzf-file-widget
bindkey '^I' fzf-tab-complete

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
